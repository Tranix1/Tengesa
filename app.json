{
  "expo": {
    "name": "Tengesa",
    "slug": "Tengesa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tengesa-brand-icon.png",
    "scheme": "tengesa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/tengesa-brand-icon.png"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/tengesa-brand-foreground.png",
        "monochromeImage": "./assets/images/tengesa-brand-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.armament.tengesa"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/tengesa-brand-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/tengesa-brand-foreground.png",
          "imageWidth": 220
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/analytics",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b6169ebd-1f35-4bc6-a384-39ceaef0ee05"
      }
    }
  }
}
